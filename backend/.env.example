# Copy to backend/.env. Never commit backend/.env.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_HTTP_TIMEOUT_MS=9000
GEMINI_REQUEST_TIMEOUT_SECONDS=12
GEMINI_ENABLED=true

SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
SACHET_SYNC_ENABLED=true
SACHET_REFRESH_SECONDS=300

# Coarse IP geolocation is disabled by default.
IP_GEOLOCATION_ENABLED=false
IP_GEOLOCATION_URL_TEMPLATE=https://ipapi.co/{ip}/json/

# Optional secret for facility verification endpoint. Use a long random value.
FACILITY_ADMIN_TOKEN=

# Open-Meteo weather cache duration. Service enforces a minimum of 60 seconds.
WEATHER_CACHE_TTL_SECONDS=600

LOG_LEVEL=INFO
