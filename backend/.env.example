# Copy this file to backend/.env and fill in your own values.
# Never commit backend/.env or paste API keys into source code.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Official NDMA SACHET India CAP RSS feed.
SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
SACHET_SYNC_ENABLED=true
SACHET_REFRESH_SECONDS=300

# IP lookup is disabled by default. When enabled, the backend sends the
# connecting public IP address to the configured provider for a coarse estimate.
# IP estimates must never be used for precise hazard-boundary decisions.
IP_GEOLOCATION_ENABLED=false
IP_GEOLOCATION_URL_TEMPLATE=https://ipapi.co/{ip}/json/

LOG_LEVEL=INFO
