# The laptop and phone can share the phone's personal hotspot; a separate router is not required.
# Find the laptop's IPv4 address with: ipconfig (Wireless LAN adapter Wi-Fi).
# IMPORTANT: do not use localhost or 127.0.0.1 here; on the phone, those point to the phone itself.
# Example only — replace the IP with the laptop's actual hotspot IPv4:
EXPO_PUBLIC_API_BASE_URL=http://192.168.43.25:8000
